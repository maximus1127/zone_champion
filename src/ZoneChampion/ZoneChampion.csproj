<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ZoneChampion.ico</ApplicationIcon>
    <AssemblyTitle>Zone Champion</AssemblyTitle>
    <Product>Zone Champion</Product>
    <!-- WFO0003 wants DPI mode set via the WinForms API, but this is a WPF app: the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms' implicit usings collide with WPF types (Application, Brush, Point...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ZoneChampion.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZoneChampion.Core\ZoneChampion.Core.csproj" />
  </ItemGroup>

</Project>
