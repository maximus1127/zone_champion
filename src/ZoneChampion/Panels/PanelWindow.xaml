<Window x:Class="ZoneChampion.Panels.PanelWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZoneChampion.Panels"
        Title="Zone Champion panel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PopupForeground}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Background" Property="Background" Value="{DynamicResource PopupHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource PopupForeground}" StrokeThickness="1.5" Opacity="0" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PopupSubtle}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="10,8,10,6" />
        </Style>

        <Style x:Key="MenuSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,6" />
            <Setter Property="Background" Value="{DynamicResource PopupBorder}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="{Binding Theme.InsetMargin}">
        <!-- Panel body. The shadow is on this empty border so icons aren't rendered through the effect. -->
        <Border x:Name="Chrome"
                Background="{Binding Theme.PanelBackground}"
                BorderBrush="{Binding Theme.PanelBorder}"
                BorderThickness="{Binding Theme.PanelBorderThickness}"
                CornerRadius="{Binding Theme.PanelCornerRadius}" />

        <ScrollViewer x:Name="Scroller"
                      Margin="{Binding Theme.ContentMargin}"
                      Focusable="False"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden">
            <ItemsControl x:Name="Items" ItemsSource="{Binding Items}" Focusable="False" Background="Transparent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="{Binding Theme.Orientation}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PanelItemViewModel}">
                        <Grid Width="{Binding Theme.TileSize}"
                              Height="{Binding Theme.TileSize}"
                              Margin="{Binding Theme.TileMargin}"
                              Background="Transparent"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="{Binding TileScale}" ScaleY="{Binding TileScale}" />
                            </Grid.RenderTransform>

                            <Border Background="{Binding TagTileBrush}" CornerRadius="{Binding Theme.TileCornerRadius}" />
                            <Border Background="{Binding Theme.ActiveBrush}" CornerRadius="{Binding Theme.TileCornerRadius}" Visibility="{Binding ActiveVisibility}" />
                            <Border Background="{Binding Theme.HoverBrush}" CornerRadius="{Binding Theme.TileCornerRadius}" Visibility="{Binding HoverVisibility}" />

                            <!-- Shown until the icon loads (or if the app has none). -->
                            <Border Width="{Binding Theme.IconSize}"
                                    Height="{Binding Theme.IconSize}"
                                    CornerRadius="8"
                                    Background="{Binding Theme.PopupSubtle}"
                                    Opacity="0.35"
                                    Visibility="{Binding PlaceholderVisibility}" />
                            <Image Source="{Binding Icon}"
                                   Width="{Binding Theme.IconSize}"
                                   Height="{Binding Theme.IconSize}"
                                   Opacity="{Binding IconOpacity}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />

                            <Border Background="{Binding Theme.IndicatorBrush}"
                                    CornerRadius="{Binding Theme.IndicatorCornerRadius}"
                                    Width="{Binding Theme.IndicatorWidth}"
                                    Height="{Binding Theme.IndicatorHeight}"
                                    HorizontalAlignment="{Binding Theme.IndicatorHorizontal}"
                                    VerticalAlignment="{Binding Theme.IndicatorVertical}"
                                    Visibility="{Binding IndicatorVisibility}" />

                            <Ellipse Fill="{Binding TagBrush}"
                                     Stroke="{Binding Theme.PanelBackground}"
                                     StrokeThickness="1.5"
                                     Width="{Binding Theme.TagSize}"
                                     Height="{Binding Theme.TagSize}"
                                     Margin="{Binding Theme.TagMargin}"
                                     HorizontalAlignment="{Binding Theme.TagHorizontal}"
                                     VerticalAlignment="{Binding Theme.TagVertical}"
                                     Visibility="{Binding TagDotVisibility}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Window title on hover -->
        <Popup x:Name="TitlePopup" AllowsTransparency="True" Focusable="False" IsHitTestVisible="False" PopupAnimation="Fade">
            <Border x:Name="TitleBorder"
                    Background="{DynamicResource PopupBackground}"
                    BorderBrush="{DynamicResource PopupBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,6">
                <TextBlock Text="{Binding Title}"
                           Foreground="{DynamicResource PopupForeground}"
                           FontFamily="{DynamicResource PopupFontFamily}"
                           FontSize="{DynamicResource PopupFontSize}"
                           MaxWidth="460"
                           TextTrimming="CharacterEllipsis" />
            </Border>
        </Popup>

        <!-- Right-click menu -->
        <Popup x:Name="MenuPopup" AllowsTransparency="True" StaysOpen="False" Focusable="False" PopupAnimation="Fade">
            <Border x:Name="MenuRoot" Padding="12" Background="Transparent">
                <Grid>
                    <Border Background="{DynamicResource PopupBackground}" CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" />
                        </Border.Effect>
                    </Border>
                    <Border BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1" CornerRadius="10" Padding="6" MinWidth="210" MaxWidth="320">
                        <StackPanel TextElement.FontFamily="{DynamicResource PopupFontFamily}" TextElement.FontSize="{DynamicResource PopupFontSize}">
                            <TextBlock x:Name="MenuTitle"
                                       Foreground="{DynamicResource PopupForeground}"
                                       FontWeight="SemiBold"
                                       Margin="10,6,10,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Color tag" Style="{StaticResource MenuHeading}" />
                            <WrapPanel x:Name="Swatches" Margin="6,0,6,2" />
                            <Border Style="{StaticResource MenuSeparator}" />
                            <StackPanel x:Name="MoveSection">
                                <TextBlock Text="Move to" Style="{StaticResource MenuHeading}" Margin="10,2,10,4" />
                                <StackPanel x:Name="MoveTargets" />
                                <Border Style="{StaticResource MenuSeparator}" />
                            </StackPanel>
                            <Button x:Name="CloseWindowButton" Style="{StaticResource MenuButton}" Content="Close window" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>
